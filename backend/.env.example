# Local development template. Copy to .env, then replace every change_me secret.
# Never use these example credentials and secrets in production.

# NestJS
NODE_ENV=development
APPLICATION_PORT=4000
APPLICATION_URL=http://localhost:4000
ALLOWED_ORIGIN=http://localhost:3000

# Cookies
COOKIES_SECRET=local-only-cookie-secret-change_me-32-chars-minimum
COOKIE_DOMAIN=

# Express session + Redis
SESSION_SECRET=local-only-session-secret-change_me-32-chars-minimum
SESSION_NAME=session
SESSION_MAX_AGE=7d
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_FOLDER=session:

# JWT
JWT_SECRET=local-only-jwt-secret-change_me-32-chars-minimum
JWT_ACCESS_TOKEN_TTL=2h
JWT_REFRESH_TOKEN_TTL=7d

# PostgreSQL (Docker Compose + local NestJS)
POSTGRES_USER=alexweb
POSTGRES_PASSWORD=change_me_postgres_local
POSTGRES_DB=full-authorization
POSTGRES_URL=postgresql://alexweb:change_me_postgres_local@localhost:5433/full-authorization?schema=public

# Redis (Docker Compose + local NestJS)
REDIS_PASSWORD=change_me_redis_local
REDIS_URL=redis://:change_me_redis_local@localhost:6379
